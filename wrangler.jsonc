{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "livesync-workers",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-04-30",
  "compatibility_flags": ["nodejs_compat"],
  // Deploys (including Workers Builds behind the Deploy button) would otherwise
  // delete variables added in the dashboard, such as the optional ones below.
  "keep_vars": true,
  "vars": {
    // CouchDB database name the LiveSync plugin connects to.
    "LIVESYNC_DATABASE": "vault",
    "LIVESYNC_VAULT_ID": "primary",
    "SEMANTIC_SEARCH": "off",
    // Username the LiveSync plugin logs in with (the password is the LIVESYNC_PASSWORD secret).
    "LIVESYNC_USERNAME": "obsidian",
    // Optional variables are left out because every entry here becomes a required
    // field in the Deploy to Cloudflare form. Add them in the dashboard (or here) if needed:
    //   VAULT_EXCLUDED_FOLDERS: comma-separated vault folders to leave out of search indexes.
    //   SEMANTIC_SEARCH: "off" to run without semantic search (no embeddings, no Vectorize usage;
    //     full-text search keeps working).
    //   MCP_STATIC_TOKEN_SCOPES: extra scopes for MCP_STATIC_TOKEN (vault:append,vault:write).
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Failed LiveSync / admin sign-ins per client IP. The failure that goes past the
  // limit (the 11th within a minute) locks that IP out for 15 minutes
  // (worker/throttle.ts). Remove to disable.
  // namespace_id only has to be unique among this account's rate limiters.
  "ratelimits": [
    { "name": "AUTH_FAILURE_LIMITER", "namespace_id": "4801", "simple": { "limit": 10, "period": 60 } }
  ],
  "r2_buckets": [
    { "binding": "FTS_BUCKET", "bucket_name": "livesync-fts" },
    { "binding": "CONTENT_BUCKET", "bucket_name": "livesync-content" }
  ],
  // Optional semantic search: add AI/Vectorize bindings only when explicitly enabling it.
  "durable_objects": {
    "bindings": [
      { "name": "VAULT_DB", "class_name": "VaultDO" },
      { "name": "MCP_OBJECT", "class_name": "VaultMCP" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VaultDO", "VaultMCP"] }],
  "observability": { "enabled": true },
}

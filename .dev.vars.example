# Secrets. Copy this file to .dev.vars, fill in the values, and upload them with
# `pnpm exec cf deploy --secrets-file .dev.vars` (or add them in the Cloudflare
# dashboard under Settings → Variables and Secrets). Never commit .dev.vars.
# The username is the LIVESYNC_USERNAME variable in cloudflare.config.ts (default: obsidian).

# Password the Obsidian LiveSync plugin logs in with. Long and random is best.
LIVESYNC_PASSWORD=

# Password for the admin login (status page and authorizing MCP clients at /authorize).
ADMIN_PASSWORD=

# Random secret that signs admin session cookies and internal requests (32+ random chars).
SESSION_SECRET=

# Optional: a static bearer token for MCP clients that cannot do OAuth.
# It grants vault:read only; widen it with the MCP_STATIC_TOKEN_SCOPES variable.
# Uncomment and fill it in only if you need it.
# MCP_STATIC_TOKEN=
